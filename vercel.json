{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "cd frontend && npm ci && npm run build && mkdir -p ../public && cp -R build/* ../public/",
    "outputDirectory": "public",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.py"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
